<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <!--
            Production sources are compiled directly into the test assembly (see
            the linked <Compile> items in the csproj), so coverage collection must
            include the test assembly instead of excluding it by default.
          -->
          <IncludeTestAssembly>true</IncludeTestAssembly>
          <Format>cobertura</Format>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
